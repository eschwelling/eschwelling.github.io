---
const year = new Date().getFullYear();
---

<footer class="wrap meta">
	<p>© {year} Ethan</p>
	<p class="links">
		<a href="https://github.com/eschwelling">GitHub</a>
		<a href="/rss.xml">RSS</a>
	</p>
</footer>

<style>
	footer {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		padding-top: 1.25rem;
		padding-bottom: 3rem;
		border-top: 1px solid var(--rule);
	}
	p {
		margin: 0;
	}
	.links {
		display: flex;
		gap: 1.25rem;
	}
	a {
		color: var(--muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--ink);
	}
</style>
