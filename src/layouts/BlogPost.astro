---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { tagSlug } from '../utils/posts';

type Props = CollectionEntry<'blog'>['data'] & { minutes?: number };

const { title, description, pubDate, updatedDate, heroImage, tags = [], minutes } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} image={heroImage} />
		<style>
			.post-header {
				margin-bottom: 2.5rem;
			}
			.post-header .meta {
				margin: 0 0 0.75rem;
			}
			.post-header h1 {
				margin-bottom: 0.6rem;
			}
			.standfirst {
				font-size: 1.3rem;
				line-height: 1.45;
				color: var(--muted);
				margin: 0;
			}
			.hero {
				margin: 0 0 2.5rem;
			}
			.prose :global(h2) {
				margin-top: 2.8rem;
			}
			.read {
				margin-left: 1rem;
			}
			.post-footer {
				margin-top: 3.5rem;
				padding-top: 1.25rem;
				border-top: 1px solid var(--rule);
				font-family: var(--sans);
				font-size: 0.85rem;
				color: var(--muted);
			}
			.post-footer p {
				margin: 0 0 0.6rem;
			}
		</style>
	</head>

	<body>
		<Header />
		<main class="wrap">
			<article>
				<header class="post-header">
					<p class="meta">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<>
									, updated <FormattedDate date={updatedDate} />
								</>
							)
						}
						{minutes && <span class="read">{minutes} min read</span>}
					</p>
					<h1>{title}</h1>
					{description && <p class="standfirst">{description}</p>}
				</header>
				{
					heroImage && (
						<figure class="hero">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</figure>
					)
				}
				<div class="prose">
					<slot />
				</div>
			</article>
			<footer class="post-footer">
				{
					tags.length > 0 && (
						<p class="tags">
							Filed under{' '}
							{tags.map((tag, i) => (
								<>
									{i > 0 && ', '}
									<a href={`/tags/${tagSlug(tag)}/`}>{tag}</a>
								</>
							))}
						</p>
					)
				}
				<p class="follow">
					Thanks for reading. New posts show up in the <a href="/rss.xml">RSS feed</a>, or you can
					browse <a href="/blog">everything I’ve written</a>.
				</p>
			</footer>
		</main>
		<Footer />
	</body>
</html>
